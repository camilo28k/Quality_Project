// Modelo lógico del MVP de TiendApp (SRS §9), limitado a los 15 SWR seleccionados.
// Montos en COP enteros (D-04). Cantidades con hasta 3 decimales (AJ-03).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
}

enum Unit {
  UNIT
  KG
  LB
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum MovementType {
  INITIAL
  ENTRY
  SALE
  /// Ajuste a la baja (pérdida, daño); solo ADMIN (SWR-STK-001)
  ADJUSTMENT_OUT
  /// Devolución de stock al anular una venta (parte 4)
  VOID_RETURN
}

/// SWR-SALE-V01: una venta confirmada nunca se borra; se anula
enum SaleStatus {
  CONFIRMED
  VOIDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Extensión multiempresa: SWR-TEN-001/003, SWR-ONB-001 (los datos del asistente se completan en la parte 2)
model Company {
  id                  String    @id @default(uuid())
  tradeName           String
  legalName           String?
  taxId               String?
  description         String?
  logoUrl             String?
  email               String?
  emailVerifiedAt     DateTime?
  phone               String?
  address             String?
  city                String?
  invoicePrefix       String    @default("FAC-")
  nextInvoiceNumber   Int       @default(1)
  invoiceFooter       String?
  currency            String    @default("COP")
  timezone            String    @default("America/Bogota")
  onboardingCompleted Boolean   @default(false)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users      User[]
  categories Category[]
  products   Product[]
  sales      Sale[]
  movements  InventoryMovement[]
}

/// SWR-AUTH-001, SWR-AUTH-005
model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  /// null solo para SUPER_ADMIN (CHECK en la migración)
  companyId          String?
  mustChangePassword Boolean  @default(false)

  company   Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales     Sale[]
  movements InventoryMovement[]
}

/// SWR-CAT-001 (nombre único por empresa, AJ-06 + SWR-TEN-001)
model Category {
  id        String    @id @default(uuid())
  companyId String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@unique([companyId, name])
}

/// SWR-PROD-001, SWR-PROD-005
model Product {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  categoryId  String
  unit        Unit
  cost        Int
  price       Int
  description String?
  stock       Decimal  @db.Decimal(12, 3)
  minStock    Decimal  @db.Decimal(12, 3)
  active      Boolean  @default(true)
  /// false si lo creó un vendedor: no se vende hasta que el ADMIN lo apruebe (decisión a)
  approved    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company              @relation(fields: [companyId], references: [id])
  category      Category             @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]
  movements     InventoryMovement[]
  priceRequests PriceChangeRequest[]

  @@index([companyId, active])
}

/// El vendedor solo sugiere precios; el ADMIN aprueba o rechaza (decisión a, SWR-ROLE-003)
model PriceChangeRequest {
  id            String        @id @default(uuid())
  companyId     String
  productId     String
  requestedById String
  currentPrice  Int
  proposedPrice Int
  reason        String?
  status        RequestStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([companyId, status])
}

/// SWR-AUD-001: registro inmutable (un trigger impide UPDATE y DELETE)
model AuditLog {
  id        String   @id @default(uuid())
  /// null = acción de plataforma sin empresa
  companyId String?
  userId    String
  role      Role
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/// Stock inicial y descuentos por venta (D-05, SWR-SALE-008)
model InventoryMovement {
  id        String       @id @default(uuid())
  companyId String
  productId String
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 3)
  userId    String
  saleId    String?
  /// Obligatorio en ENTRY y ADJUSTMENT_OUT
  reason    String?
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])
}

/// SWR-SALE-004, SWR-SALE-010 (idempotencyKey único por empresa), SWR-PAY-001
model Sale {
  id             String        @id @default(uuid())
  companyId      String
  /// Vendedor que registró la venta
  userId         String
  paymentMethod  PaymentMethod
  total          Int
  idempotencyKey String
  /// SWR-INV-001: prefijo + consecutivo, único por empresa, asignado en la sentencia atómica
  invoiceNumber  String
  status         SaleStatus    @default(CONFIRMED)
  customerEmail  String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  /// SWR-SALE-V02: la reemisión apunta a la venta original que corrige
  correctsSaleId String?       @unique
  createdAt      DateTime      @default(now())

  company   Company             @relation(fields: [companyId], references: [id])
  user      User                @relation(fields: [userId], references: [id])
  items     SaleItem[]
  movements InventoryMovement[]

  correctsSale       Sale?                   @relation("Reissue", fields: [correctsSaleId], references: [id], onDelete: Restrict)
  reissuedAs         Sale?                   @relation("Reissue")
  correctionRequests SaleCorrectionRequest[]
  emails             InvoiceEmail[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, invoiceNumber])
  @@index([companyId, createdAt])
}

/// SWR-SALE-V03: el vendedor pide corregir una venta suya; el ADMIN decide
model SaleCorrectionRequest {
  id            String        @id @default(uuid())
  companyId     String
  saleId        String
  requestedById String
  reason        String
  status        RequestStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([companyId, status])
}

/// SWR-SALE-003, SWR-SALE-005 (precio aplicado), SWR-MED-002
model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unit      Unit
  unitPrice Int
  subtotal  Int

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

enum EmailKind {
  INVOICE
  VOID_NOTICE
  REISSUE
}

enum EmailStatus {
  SENT
  FAILED
}

/// SWR-MAIL-001: código de un solo uso para verificar el correo de la empresa
model EmailVerification {
  id        String    @id @default(uuid())
  companyId String
  email     String
  /// SHA-256 del código; el código nunca se guarda en claro
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, createdAt])
}

/// SWR-MAIL-002: cada envío (o intento fallido) de una factura queda registrado
model InvoiceEmail {
  id        String      @id @default(uuid())
  companyId String
  saleId    String
  to        String
  kind      EmailKind
  status    EmailStatus
  error     String?
  messageId String?
  createdAt DateTime    @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId, createdAt])
}
