# Copiar a .env y completar. Nunca subir .env al repositorio.

# Supabase > Project Settings > Database > Connection string
# Pooler (puerto 6543) para la aplicación:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para migraciones:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

PORT=4000
FRONTEND_URL="http://localhost:3000"
LOG_DEBUG=false

# Cuentas iniciales (prisma/seed.ts)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_SELLER_EMAIL=""
SEED_SELLER_PASSWORD=""
# Dueño de la plataforma (multiempresa)
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# Correo (parte 5). Opción (a): sale desde la plataforma con el nombre de la empresa
# y Reply-To al correo verificado de la empresa. En desarrollo: Mailpit (SMTP local,
# bandeja en http://localhost:8025). Sin SMTP_HOST no se envían correos (se registran como fallidos).
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_ADDRESS="facturas@tiendapp.test"
