{
  "info": {
    "name": "TiendApp API",
    "description": "Pruebas de API de TiendApp (guía §12). Organizadas por módulo; la mayoría verifica reglas del dominio, no solo CRUD. Ejecutar en orden: cada carpeta usa variables de la anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "API-01 Login administrador válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y token JWT', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().accessToken).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/); });",
                  "pm.test('rol ADMIN y sin hash de contraseña', () => { const u = pm.response.json().user; pm.expect(u.role).to.eql('ADMIN'); pm.expect(u).to.not.have.property('passwordHash'); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "description": "SWR-AUTH-001. Guarda el token para las demás solicitudes.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-02 Login con contraseña incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('mensaje general', () => pm.expect(pm.response.json().message).to.eql('Correo o contraseña incorrectos'));",
                  "pm.test('no entrega token', () => pm.expect(pm.response.json()).to.not.have.property('accessToken'));"
                ]
              }
            }
          ],
          "request": {
            "description": "SWR-AUTH-002: mensaje general que no revela si el correo existe.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"contraseña-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-03 Login vendedor válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y rol SELLER', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.eql('SELLER'); });",
                  "pm.collectionVariables.set('sellerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "description": "",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"{{sellerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-04 Ruta protegida sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin sesión', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "description": "Guía §5: acceso a ruta protegida sin sesión.",
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
