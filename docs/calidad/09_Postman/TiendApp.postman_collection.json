    {
      "name": "3. Ventas",
      "item": [
        {
          "name": "API-11 Venta de 3 unidades descuenta inventario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('saleKey', require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('201 venta nueva', () => { pm.response.to.have.status(201); pm.expect(b.replayed).to.eql(false); });",
                  "pm.test('subtotal y total 3 × 2500 = 7500', () => { pm.expect(b.sale.items[0].subtotal).to.eql(7500); pm.expect(b.sale.total).to.eql(7500); });",
                  "pm.test('precio aplicado y medio de pago', () => { pm.expect(b.sale.items[0].unitPrice).to.eql(2500); pm.expect(b.sale.paymentMethod).to.eql('CASH'); });",
                  "pm.collectionVariables.set('saleId', b.sale.id);"
                ]
              }
            }
          ],
          "request": {
            "description": "TC-SALE-001 / SWR-SALE-003/004/008 / SWR-PAY-001.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
