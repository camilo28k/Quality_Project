              "raw": "{\n  \"idempotencyKey\": \"{{saleKey}}\",\n  \"paymentMethod\": \"CASH\",\n  \"items\": [\n    {\n      \"productId\": \"{{unitProductId}}\",\n      \"quantity\": 3\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
